{
    "name": "scabo/coleo-view",
    "description": "Generates a user interface from a template and input data",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Coleo\\View\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ColeoTest\\View\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sergey Shevyakov",
            "email": "scabo.dev@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "*"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --display-warnings",
        "inspect": "vendor/bin/phpstan analyse",
        "style_check": "vendor/bin/phpcs",
        "style_fix": "vendor/bin/phpcbf"
    }
}
